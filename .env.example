# Password for /admin (required to enable the admin panel)
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET=
# Postgres connection string (Neon: use the pooled one). Without it the site stores data in local files.
DATABASE_URL=
# Optional, file storage only: where content.json, leads.json and uploads/ live (default: ./data)
# DATA_DIR=/var/lib/ad-group
